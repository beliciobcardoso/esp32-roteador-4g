# Fase 5 (NAT): LWIP_IPV4_NAPT depende de LWIP_IP_FORWARD e ja faz
# `select LWIP_L2_TO_L3_COPY` sozinho (lwip/Kconfig:212-216) — sem a copia L2->L3 o
# driver WiFi entrega buffers que o forward nao pode reescrever.
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y

# Fase 4 (modem PPP via esp_modem) — habilita suporte PPP no esp_netif/lwIP,
# desligado por default no sdkconfig do esp-wrover-kit.
CONFIG_LWIP_PPP_SUPPORT=y

# A Vivo autentica o APN via PAP. Sem PAP_SUPPORT o lwIP compila
# pppapi_set_auth fora e esp_netif_ppp_set_auth devolve ESP_ERR_ESP_NETIF_IF_NOT_READY,
# ou seja: usuario/senha do APN seriam ignorados sem nenhum erro de conexao.
CONFIG_LWIP_PPP_PAP_SUPPORT=y

# Fase 4: a flash real da T-A7670E R2 e de 4MB, mas o board esp-wrover-kit do PlatformIO
# entrava com o default de 2MB e a tabela partitions_singleapp (app de 1MB, ja em 87%).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Tabela propria: dois slots de app de 1.875MB para OTA. O dispositivo fica em campo
# com link celular proprio — gravar por serial em cada atualizacao nao e viavel, e o
# dual-slot permite voltar atras se um firmware ruim subir.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Fase 6: sem isso o driver reserva slots de chave para o ESP-NOW e corta o AP em 10
# clientes ("Affected by the ESP-NOW encrypt num, set the max connection num to 10").
# Nao usamos ESP-NOW em lugar nenhum, entao zerar libera o teto real de 15
# (ESP_WIFI_MAX_CONN_NUM, esp_wifi_types.h:320).
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0

# Fase 6 (reconexao): sem LCP echo uma perda silenciosa de RF nunca gera evento — o PPP
# fica "up" para sempre, o NAT continua armado e o roteador vira buraco negro. Com echo,
# 3 falhas de 3s viram NETIF_PPP_ERRORPEERDEAD em ~9s, que e o gatilho da reconexao.
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=3
CONFIG_LWIP_LCP_MAXECHOFAILS=3

# Fase 7 (relogio): o default e 1 servidor SNTP, e com ele o segundo setservername() e
# ignorado sem nenhum erro — a placa ficaria dependendo so do ntp.br. Dois servidores
# custam um nome resolvido a mais e evitam ficar sem hora quando um deles cai.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Fase 8 (OTA): o bootloader passa a imagem recem-gravada para PENDING_VERIFY no primeiro
# boot e so a mantem se o firmware se confirmar; reboot antes disso volta para o slot
# anterior. E o que separa "atualizei e a placa sumiu" de "atualizei, deu ruim, voltou".
# Vem junto com a janela de verificacao do loop() — sem a chave, confirmar nao faz nada;
# sem a confirmacao, todo boot seguinte reverteria.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Task Watchdog com panic. Sem isto ele so imprime aviso no serial a cada 5s e nao reinicia
# nada: um firmware que trava — while infinito, deadlock, espera de I/O sem timeout — fica
# de pe, mudo e inalcancavel para sempre, e o rollback do bootloader nunca chega a rodar
# porque ele depende de um reset que nunca acontece. Com panic, travar vira reset, e reset
# dentro da janela de confirmacao e exatamente o que devolve a imagem anterior.
CONFIG_ESP_TASK_WDT_PANIC=y

# Entrega direta no caminho de entrada do lwIP, em vez de enfileirar para a task tcpip.
#
# Sem isto, cada quadro PPP entrante ocupa um slot da fila da task tcpip, e com NAPT a mesma
# task ainda faz o forward e entrega ao driver WiFi antes de drenar o proximo. Rajada de
# download entra mais rapido do que ela escoa, e o excedente vira
# `pppos_input_tcpip failed with -1` (ERR_MEM) — debito 13.
#
# Medido em 20/09/2026, em duas rodadas:
#
#  - fila 32, download de video: ~3166 descartes, pico de 1239 numa janela de 30 s
#  - fila 64, download de um zip de 19 MB: 1727 descartes, pico de 540
#
# Dobrar a fila nao resolveu — so empurrou o ponto de saturacao, como o proprio debito 13
# previa antes da medicao. O gargalo e drenagem, nao tamanho: a task nao escoa no ritmo da
# rajada, e fila maior compra menos de um segundo de folga.
#
# A mesma medicao derrubou a hipotese alternativa do debito, de heap esgotado: o heap interno
# livre nunca desceu de 113 KB, contra um piso de 32 KB. E fila, nao memoria.
#
# CORE_LOCKING troca a fila por um mutex: quem recebe entrega direto, segurando o lock, em
# vez de postar mensagem. A classe inteira do problema deixa de existir porque nao ha mais
# fila para encher. Custo: muda o modelo de concorrencia do lwIP.
#
# O codigo deste projeto ja esta do lado certo dessa mudanca — o dns_forwarder usa BSD
# sockets, que adquirem o lock por dentro, e o nat_bridge chama ip_napt_enable por
# esp_netif_tcpip_exec(), que com CORE_LOCKING passa a pegar o lock em vez de postar.
# Validado em bancada com CONFIG_LWIP_CHECK_THREAD_SAFETY=y num build descartavel, que
# aborta em runtime a cada chamada de API feita fora do lock.
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT=y

# Buffers de registro do TLS dimensionados para a telemetria MQTT (PRD 14, Fase 9), e nao
# para HTTPS de pagina inteira, que e para o que o default de 16 KB + 4 KB foi pensado. Sao
# ~10 KB de DRAM interna de volta por conexao, e a DRAM e o risco numero um da fase: o
# handshake do mbedTLS tem pico de ~40-50 KB e a PSRAM nao esta compilada.
#
# Nenhum outro caminho do firmware usa TLS hoje (a pagina e HTTP, o OTA vem pela pagina, o
# SNTP e UDP), entao nada alem do MQTT e afetado.
#
# O IN precisa acomodar o maior registro que o broker mandar. Durante o handshake e a cadeia
# de certificados, ~4-5 KB com Let's Encrypt; depois disso a placa so recebe CONNACK e PUBACK,
# de poucos bytes, porque nao assina topico nenhum. Broker que mande cadeia maior que 8 KB
# derruba o handshake com erro de registro grande demais — e o sintoma a procurar se o
# primeiro contato com o broker falhar ali.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
