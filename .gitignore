.pio
sdkconfig.*
!sdkconfig.defaults
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/extensions.json
.vscode/ipch

# Componentes baixados pelo ESP-IDF Component Manager — reprodutíveis a partir de
# src/idf_component.yml + dependencies.lock (este sim versionado).
managed_components/

# Índice da ferramenta Serena (agente), não é artefato do projeto.
.serena/

# Configuracao local de maquina/placa (porta serial, etc). Carregado pelo extra_configs
# do platformio.ini quando existe; o padrao versionado vale quando nao existe.
platformio_override.ini

# Gerado a cada build por scripts/firmware_version.py, a partir do `git describe`. Versionar
# congelaria a versao de quem clonasse o repo.
version.txt
